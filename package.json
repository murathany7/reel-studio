{
  "name": "reel-studio",
  "version": "0.2.7",
  "description": "Agency-quality marketing reels, ads and posts made by Claude Code. Free and open source; no per-video fees.",
  "type": "module",
  "bin": { "reel-studio": "bin/reel-studio.mjs" },
  "files": [
    "bin/",
    "desk/",
    "!desk/.state.json",
    "core/README.md",
    "core/package.json",
    "core/package-lock.json",
    "core/render.mjs",
    "core/lib/",
    "engines/",
    "looks/",
    "!**/__pycache__",
    "scripts/",
    "templates/",
    "brands/_template/",
    "productions/_TEMPLATE/",
    "examples/engines-demo/index.html",
    "examples/engines-demo/README.md",
    "examples/engines-demo/plates/blob.mp4",
    "examples/engines-demo/talk.visemes.js",
    "examples/reel-layer/index.html",
    "examples/reel-layer/rive.html",
    "examples/reel-layer/README.md",
    "examples/reel-layer/make-audio.sh",
    "examples/reel-layer/audio/",
    ".agents/skills/"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:python": "packaging/build-python.sh && cd python && uv run --isolated --with . python -m unittest discover -s tests -v"
  },
  "engines": { "node": ">=18" },
  "keywords": ["video", "reels", "marketing", "claude-code", "claude-code-plugin", "claude-skills", "ai-video", "video-generation", "video-ads", "motion-graphics", "instagram-reels", "tiktok", "gsap", "threejs", "pixi", "blender", "ffmpeg", "headless-chrome", "remotion-alternative"],
  "author": "Murathan Yıldırım (https://github.com/murathany7)",
  "license": "MIT",
  "homepage": "https://github.com/murathany7/reel-studio#readme",
  "repository": { "type": "git", "url": "git+https://github.com/murathany7/reel-studio.git" },
  "bugs": "https://github.com/murathany7/reel-studio/issues"
}
