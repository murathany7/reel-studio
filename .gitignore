node_modules/
.DS_Store
**/qa/flagged/
# Desk: renders made from the desk and what it has open (review.json stays tracked)
**/qa/desk/
desk/.state.json

# No videos, audio renders or GIFs in git: they go on GitHub Releases (or stay local). The only exceptions are the
# two tiny inputs the examples need to run (a 40 KB Blender plate, a 128 KB synth loop).
*.gif
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.ogg
!examples/reel-layer/audio/music.mp3
*.mp4
*.MP4
*.mov
*.MOV
*.m4v
*.webm
*.mkv
*.avi
*.zip
!examples/engines-demo/plates/blob.mp4

# Generated QA evidence for examples (rebuild with the commands in each README)
examples/*/qa/
__pycache__/

# Productions: only sources and written reports go in git (README, composition, audio scripts and cue sheets,
# qa/*.md). Renders, covers, stills and contact sheets are rebuilt from the README's commands.
productions/**/export/
productions/**/qa/**/*.jpg
productions/**/qa/**/*.png
productions/**/qa/**/*.csv
productions/**/qa/**/*.log
productions/**/qa/beats/
productions/**/refs/*.jpg
productions/**/refs/*.png

# Yuppo is a company brand: its kit, fonts (Pangea Afrikan is commercial) and productions stay out of the public repo
brands/yuppo/
productions/yuppo/

# Python package build output (packaging/build-python.sh)
python/src/reel_studio/kit/
python/dist/
dist/

# Personal distribution stats (check-metrics): local only
scripts/metrics.mjs
.agents/skills/check-metrics/
metrics.jsonl
scripts/.npmignore

# Third-party sample files fetched for checks (see examples/reel-layer/rive.html)
examples/reel-layer/assets/
!productions/_TEMPLATE/export/
!productions/_TEMPLATE/export/.gitkeep
